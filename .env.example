# Public URL of the site (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.jesseandson.com

# Contact & appointment form — sends through Resend (https://resend.com).
# Without RESEND_API_KEY the form falls back to Email / WhatsApp / LINE with
# the message pre-filled, so enquiries still reach you.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@jesseandson.com
# Must be a sender on a domain verified in Resend, e.g. "Jesse & Son <web@jesseandson.com>"
CONTACT_FROM_EMAIL=
